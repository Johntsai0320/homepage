# ==============================================================================
# Homepage 環境變數範本（Synology DS718+ 2GB RAM + Tailscale）
# 使用前請執行：cp .env.example .env
# ==============================================================================

# 容器映像檔（預設拉取 GitHub Actions 自動建置的 GHCR 多架構映像）
# 若需改用官方原版映像或鎖定特定版本，可於此指定
HOMEPAGE_IMAGE=ghcr.io/johntsai0320/homepage:latest

# 時區、監聽與記憶體調校設定（避開 novel 3000 與 uptime-kuma 3001）
TZ=Asia/Taipei
HOMEPAGE_BIND_IP=0.0.0.0
HOMEPAGE_PORT=3010
NODE_OPTIONS=--max-old-space-size=128

# [必填] 允許存取的 Host 清單（逗號分隔且勿留空白，含非預設埠號）
# 請務必加入您的 NAS 區網 IP、Tailscale IP、MagicDNS 或反向代理網域，例如：
# HOMEPAGE_ALLOWED_HOSTS=192.168.1.100:3010,100.64.0.10:3010,ds718.tailxxxx.ts.net:3010,home.yourname.synology.me
HOMEPAGE_ALLOWED_HOSTS=localhost:3010,127.0.0.1:3010

# ------------------------------------------------------------------------------
# NAS 服務入口位址（將自動注入 config/services.yaml，不外洩私網/Tailscale IP 至 Git）
# 建議填入您的 Tailscale IP 或 MagicDNS 主機名稱，這樣內外網連著 Tailscale 都能點開
# ------------------------------------------------------------------------------
HOMEPAGE_VAR_NAS_HOST=192.168.1.100
HOMEPAGE_VAR_DSM_PORT=5001

HOMEPAGE_VAR_LIBRETV_URL=http://192.168.1.100:8080
HOMEPAGE_VAR_NOVEL_URL=http://192.168.1.100:3000
HOMEPAGE_VAR_VAULTWARDEN_URL=http://192.168.1.100:8200
HOMEPAGE_VAR_UPTIME_KUMA_URL=http://192.168.1.100:3001

# ------------------------------------------------------------------------------
# 進階：啟動時自動從 GitHub 同步最新 config/*.yaml 範本（預設關閉，以免覆蓋本機修改）
# ------------------------------------------------------------------------------
AUTO_SYNC_GITHUB=false
GITHUB_REPO=https://github.com/Johntsai0320/homepage.git
GITHUB_BRANCH=main
