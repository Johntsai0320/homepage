         "value" : "5001"
      },
      {
         "key" : "HOMEPAGE_VAR_LIBRETV_URL",
         "value" : "http://192.168.1.100:8080"
      },
      {
         "key" : "HOMEPAGE_VAR_NOVEL_URL",
         "value" : "http://192.168.1.100:3000"
      },
      {
         "key" : "HOMEPAGE_VAR_VAULTWARDEN_URL",
         "value" : "http://192.168.1.100:8200"
      },
      {
